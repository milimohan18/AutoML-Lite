# Copy this file to .env and fill in your own values. Never commit .env.

# Your LocalWP site URL (shown in LocalWP under "Site domain"), without a trailing slash
WP_SITE_URL=http://your-site.local

# The WordPress user that will own the published posts
WP_USERNAME=your-wordpress-username

# Application Password from WordPress: Users > Profile > Application Passwords
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
